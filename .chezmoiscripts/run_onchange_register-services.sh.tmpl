#!/usr/bin/env bash
set -uo pipefail

# ── Chezmoi run_onchange: Register autostart services ───────────────────────
# Executed by chezmoi during `chezmoi apply`. Hands the services you DECLARE to
# the OS init system so they start on their own at boot/login. This is the
# bridge chezmoi itself can't be (a `run_` script must finish; a tunnel never
# does) — so instead of running services, we register them with systemd/launchd/
# Task Scheduler and let the OS supervise them.
#
# WHICH services autostart is config-driven, symmetric with the ENABLE_* install
# flags. Declare them in the DOTFILES_SERVICES env var as a space-separated list
# of "tool:sub" specs when you bootstrap / apply:
#
#     DOTFILES_SERVICES="vscode:tunnel tailscale:up" chezmoi apply
#
# Empty (the default) = no-op: nothing touches your init system. Per-service
# runtime config (tunnel name, ports, tokens) is read by each service at run
# time from its env vars / Infisical, not baked in here. To stop autostarting
# one, drop it from the list and run: services/index.sh disable <tool:sub>.
#
# Re-runs when this rendered content changes: the declared list is embedded
# below, and every services/*.sh is fingerprinted so edits re-register.
#
# Declared services: {{ env "DOTFILES_SERVICES" | default "(none)" }}
#
# services/ content fingerprint (do not edit — regenerated by chezmoi):
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ range (glob (joinPath $sourceDir "services" "*.sh")) -}}
#   {{ . | replace $sourceDir "" }}: {{ include . | sha256sum }}
{{ end -}}
# ────────────────────────────────────────────────────────────────────────────

SOURCE_DIR="{{ .chezmoi.sourceDir }}"
DOTFILES_SERVICES="{{ env "DOTFILES_SERVICES" }}"

# Nothing declared → nothing to do.
[[ -z "${DOTFILES_SERVICES// /}" ]] && exit 0

# Load the shared logger so this phase lands in the same run log as install.
source "${SOURCE_DIR}/utilities/index.sh"
log_set_component "services-register"

log_section "Registering declared autostart services"
log_info "Declared: ${DOTFILES_SERVICES}"

for spec in ${DOTFILES_SERVICES}; do
    log_info "enable ${spec}"
    # Best-effort: a failure (e.g. no systemd in a container) must not abort apply.
    bash "${SOURCE_DIR}/services/index.sh" enable "${spec}" || \
        log_warn "could not enable '${spec}' (see message above)."
done
