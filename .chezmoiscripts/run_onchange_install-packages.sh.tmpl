#!/usr/bin/env bash
set -eo pipefail

# ── Chezmoi run_onchange: Install all packages ──────────────────────────────
# Executed by chezmoi during `chezmoi apply`. Delegates to the package
# orchestrator, which installs every tool (idempotently) in dependency order.
#
# Why run_onchange_ (not run_once_):
#   run_once_ runs exactly once per unique *script* content — it would NOT
#   re-run when you add or edit a file under packages/, so new packages would
#   silently never install. run_onchange_ re-runs whenever this script's
#   rendered content changes; embedding a hash of every packages/*.sh file
#   below makes "a package changed" == "this script changed", so installs are
#   re-applied on the next `chezmoi apply`. Package scripts are idempotent, so
#   re-running is safe (already-installed tools are skipped).
#
# packages/ content fingerprint (do not edit — regenerated by chezmoi):
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ range (glob (joinPath $sourceDir "packages" "*.sh")) -}}
#   {{ . | replace $sourceDir "" }}: {{ include . | sha256sum }}
{{ end -}}
# ────────────────────────────────────────────────────────────────────────────

SOURCE_DIR="{{ .chezmoi.sourceDir }}"

bash "${SOURCE_DIR}/packages/index.sh"
