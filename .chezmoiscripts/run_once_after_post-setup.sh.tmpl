#!/usr/bin/env bash
set -eo pipefail

# ── Chezmoi run_once_after: Post-Setup ──────────────────────────────────────
# Executed once by chezmoi AFTER all other run_once scripts (packages, etc.)
# because of the "after" keyword in the filename.
# Performs system-level configuration: shell change, auth, plugin init.
# ────────────────────────────────────────────────────────────────────────────

SOURCE_DIR="{{ .chezmoi.sourceDir }}"

bash "${SOURCE_DIR}/scripts/core/post-setup.sh"
