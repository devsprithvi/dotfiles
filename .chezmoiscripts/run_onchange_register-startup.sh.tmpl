#!/usr/bin/env bash
set -uo pipefail

# ── Chezmoi run_onchange: dotfile startup ───────────────────────────────────
# The dotfile startup runs a declared set of preset commands automatically after
# every reboot. This script — executed during `chezmoi apply` — is the ONLY
# interface: the commands/ folder is ignored by chezmoi (never copied to your
# home), so you never run anything there by hand. You just DECLARE the list when
# applying and this reconciles it into OS autostart units:
#
#     DOTFILES_STARTUP="vscode:tunnel tailscale:up" chezmoi apply
#
# The list is the single source of truth: listed presets are enabled to start at
# every boot; anything previously managed but no longer listed is disabled. Empty
# (the default) removes everything we manage. Per-preset settings (tunnel name,
# ports, ...) come from each preset's own env vars, so the list is a plain set of
# names.
#
# Re-runs when this rendered content changes: the declared list is embedded below
# and every commands/*.sh is fingerprinted, so editing a preset re-registers.
#
# Declared: {{ env "DOTFILES_STARTUP" | default "(none)" }}
#
# commands/ content fingerprint (do not edit — regenerated by chezmoi):
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ range (glob (joinPath $sourceDir "commands" "*.sh")) -}}
#   {{ . | replace $sourceDir "" }}: {{ include . | sha256sum }}
{{ end -}}
{{ range (glob (joinPath $sourceDir "commands" "presets" "*.sh")) -}}
#   {{ . | replace $sourceDir "" }}: {{ include . | sha256sum }}
{{ end -}}
# ────────────────────────────────────────────────────────────────────────────

SOURCE_DIR="{{ .chezmoi.sourceDir }}"
DOTFILES_STARTUP="{{ env "DOTFILES_STARTUP" }}"

# Load the shared logger so this phase lands in the same run log as install.
source "${SOURCE_DIR}/utilities/index.sh"
log_set_component "startup-apply"

log_section "Reconciling dotfile startup commands"
log_info "Declared: ${DOTFILES_STARTUP:-(none)}"

# Word-split the space-separated list into arguments (empty is valid: it removes
# everything we manage). Best-effort: a failure must not abort `chezmoi apply`.
# shellcheck disable=SC2086
bash "${SOURCE_DIR}/commands/startup.sh" ${DOTFILES_STARTUP} || \
    log_warn "startup reconcile reported a problem (see messages above)."
